<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Refrimak | Assistência técnica em refrigeração e máquinas de lavar</title>
<style>
:root{color-scheme:dark;--bg:#050b14;--bg2:#0a1626;--card:#0d1c30;--line:#16304d;--blue:#1e6bff;--cyan:#27d4ff;--txt:#fff;--mut:#9fb4cc;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html{scroll-padding-top:env(safe-area-inset-top,0px);scroll-behavior:smooth}
*{box-sizing:border-box;margin:0}
body{background:var(--bg);color:var(--txt);font-family:"Barlow Condensed","Arial Narrow",Arial,sans-serif;line-height:1.35;font-size:17px}
.w{max-width:1120px;margin:auto;padding:0 20px}
h1,h2,h3{font-family:Impact,"Arial Narrow Bold","Arial Black",sans-serif;text-transform:uppercase;letter-spacing:.5px;font-weight:400}
.btn{display:inline-block;background:linear-gradient(90deg,var(--blue),var(--cyan));color:#00101f;font-weight:700;text-transform:uppercase;letter-spacing:1px;padding:14px 26px;border-radius:6px;text-decoration:none;border:0;cursor:pointer;font:700 16px inherit;font-family:inherit;box-shadow:0 0 22px #27d4ff44}
.btn.o{background:none;color:var(--cyan);border:1px solid var(--cyan);box-shadow:none;padding:10px 18px}
header{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:#050b14ee;backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:#050b14;z-index:10}
header .w{display:flex;align-items:center;justify-content:space-between;height:64px}
.logo{font-family:Impact,sans-serif;font-size:28px;letter-spacing:1px;display:flex;align-items:center;gap:8px}
.logo b{color:var(--cyan);font-weight:400}
nav a{color:var(--mut);text-decoration:none;margin-left:20px;text-transform:uppercase;font-size:15px;letter-spacing:1px}
@media(max-width:700px){nav a:not(.keep){display:none}}
.hero{position:relative;overflow:hidden;background:radial-gradient(circle at 78% 40%,#0b3a78 0,#07182e 40%,var(--bg) 75%)}
.hero .w{display:grid;grid-template-columns:1.1fr .9fr;gap:20px;align-items:center;padding-top:56px;padding-bottom:56px}
@media(max-width:800px){.hero .w{grid-template-columns:1fr}}
.hero h1{font-size:clamp(44px,8vw,86px);line-height:.95}
.hero h1 span{color:var(--cyan);text-shadow:0 0 28px #27d4ff88;display:block}
.hero p{color:var(--mut);font-size:20px;margin:18px 0 26px;max-width:460px}
.tags{margin-top:20px;font-size:14px;letter-spacing:1.5px;text-transform:uppercase;color:var(--mut)}
.tags i{color:var(--cyan);font-style:normal;margin:0 6px}
.eyebrow{color:var(--cyan);text-transform:uppercase;letter-spacing:3px;font-size:13px}
section{padding:56px 0}
.head{display:flex;justify-content:space-between;align-items:end;margin-bottom:24px;gap:12px;flex-wrap:wrap}
h2{font-size:34px}
h2::after{content:"";display:block;width:44px;height:3px;background:var(--cyan);margin-top:8px}
.grid4{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px}
.card{background:var(--card);border:1px solid var(--line);border-radius:10px;overflow:hidden;transition:.2s}
.card:hover{border-color:var(--cyan);box-shadow:0 0 24px #27d4ff22;transform:translateY(-3px)}
.card .img{height:150px;display:grid;place-items:center;background:linear-gradient(160deg,#10294a,#071221)}
.card .b{padding:16px;position:relative}
.ic{width:44px;height:44px;border-radius:50%;background:linear-gradient(135deg,var(--blue),var(--cyan));display:grid;place-items:center;position:absolute;top:-22px;left:16px;box-shadow:0 0 16px #27d4ff66}
.card h3{font-size:19px;margin-top:20px;margin-bottom:6px}
.card p{color:var(--mut);font-size:16px}
.card a{color:var(--cyan);font-size:14px;text-transform:uppercase;letter-spacing:1px;text-decoration:none;display:inline-block;margin-top:10px}
svg.l{width:48px;height:48px;fill:none;stroke:var(--cyan);stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.ic svg{width:22px;height:22px;stroke:#00101f;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.why{background:var(--bg2);border-block:1px solid var(--line);text-align:center}
.why h2::after{margin-inline:auto}
.why .grid4>div{padding:8px 14px;border-left:1px solid var(--line)}
.why .grid4>div:first-child{border:0}
.why h3{font-size:19px;margin:10px 0 4px}
.why p{color:var(--mut)}
.two{display:grid;grid-template-columns:1fr 1fr;gap:24px}
@media(max-width:800px){.two{grid-template-columns:1fr}}
.ba{display:grid;grid-template-columns:1fr 1fr;border:1px solid var(--line);border-radius:10px;overflow:hidden;height:230px}
.ba div{position:relative;display:grid;place-items:center}
.ba .a{background:linear-gradient(160deg,#173a66,#0a1e38)}
.ba .d{background:linear-gradient(160deg,#2b2f35,#14161a)}
.ba em{position:absolute;top:10px;left:10px;font:700 12px Arial;letter-spacing:1px;padding:4px 10px;border-radius:4px;background:#e3e8ee;color:#111;font-style:normal}
.ba .a em{background:var(--cyan)}
.ba svg{width:90px;height:140px}
.panel{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:24px}
form{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:18px}
form .f{grid-column:1/-1}
input,select,textarea{width:100%;background:#071221;border:1px solid var(--line);color:#fff;border-radius:6px;padding:12px;font:16px inherit;font-family:Arial,sans-serif;font-size:14px}
input:focus,select:focus,textarea:focus{outline:0;border-color:var(--cyan)}
textarea{min-height:80px;resize:vertical}
.stars{color:var(--cyan);letter-spacing:2px}
.rev{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px;margin-top:20px}
.rev .card{padding:18px}
.who{display:flex;gap:10px;align-items:center;margin-bottom:8px}
.av{width:42px;height:42px;border-radius:50%;background:linear-gradient(135deg,var(--blue),var(--cyan));display:grid;place-items:center;font-weight:700;color:#00101f}
.brands{display:flex;flex-wrap:wrap;justify-content:center;gap:14px 34px;padding:28px 0;border-block:1px solid var(--line);color:var(--mut);font-family:Impact,sans-serif;font-size:22px;letter-spacing:2px;text-transform:uppercase}
.cta{text-align:center;background:linear-gradient(90deg,#0b3a78,#0a6d8f);padding:44px 20px}
.cta h2{font-size:clamp(30px,6vw,52px)}.cta h2::after{margin-inline:auto;background:#fff}
.cta p{margin:10px 0 20px;color:#dff4ff}
footer{padding:26px 0;text-align:center;color:var(--mut);font-size:14px}
</style>
</head>
